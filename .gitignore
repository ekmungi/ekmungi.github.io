# Dependencies and build output (all regenerated by npm run build / npm test; fixture-builds/ holds the site tests' own fixture content and builds)
node_modules/
dist/
dist-test/
fixture-builds/
.astro/

# Old Jekyll build output, no longer used
_site/
.jekyll-cache/

# Local-only files that must never be committed (personal identifier list for the privacy check)
private/

# Local working files for the build process (plans, task briefs and reports); never committed
.superpowers/
