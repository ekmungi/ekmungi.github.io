---
// One section frame on a page's 12-column grid; span sets the columns it covers and title adds an <h2>.
interface Props {
  span: 4 | 5 | 7 | 8 | 12;
  title?: string;
}

const { span, title } = Astro.props;
---

<section class={`frame s${span}`}>
  {title && <h2>{title}</h2>}
  <slot />
</section>
