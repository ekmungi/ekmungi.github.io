---
// One research theme page: title, place and period, then the problem and what was done, with the theme's papers beside them when it has any.
import { getCollection, render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import Frame from '../../../../components/Frame.astro';
import PaperTitle from '../../../../components/PaperTitle.astro';
import PageHead from '../../../../components/PageHead.astro';
import { SITE } from '../../../../data/site';

/**
 * Tell Astro which theme pages to build: one per file in src/content/research, at /profile/research/<file name>/.
 * @returns one route per theme, carrying the theme entry as a prop.
 */
export async function getStaticPaths() {
  const themes = await getCollection('research');
  return themes.map((theme) => ({ params: { slug: theme.id }, props: { theme } }));
}

const { theme } = Astro.props;
// The Markdown body holds "The problem" and "What was done" as two headings.
const { Content } = await render(theme);
const { title, place, period, summary, papers } = theme.data;
// With no papers to show, the text takes the full width: a section that cannot be sourced is left out.
const hasPapers = papers.length > 0;
---

<Base title={`${title} | ${SITE.name}`} page="profile" subpage description={summary}>
  <PageHead title={title} lede={`${place} · ${period}`}>
    <p class="summary">{summary}</p>
  </PageHead>
  <div class="grid">
    <Frame span={hasPapers ? 8 : 12}>
      <div class="text">
        <Content />
      </div>
    </Frame>
    {
      hasPapers && (
        <Frame span={4} title="Papers">
          <ul class="papers">
            {papers.map((paper) => <li><PaperTitle paper={paper} /></li>)}
          </ul>
        </Frame>
      )
    }
  </div>
</Base>

<style>
  .summary {
    margin: 10px 0 0;
    max-width: 820px;
  }

  /* The headings come from the Markdown, so they are reached through :global. Every heading after the first gets space above it. */
  .text :global(h2:not(:first-child)) {
    margin-top: 28px;
  }

  .papers {
    margin: 0;
    padding-left: 20px;
    font-size: 16px;
  }

  .papers li {
    margin-bottom: 8px;
  }
</style>
