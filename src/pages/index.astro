---
// Landing page: portrait, name, role and a short background, then the doors to Profile and Projects, and to Blog once a post is published.
import Base from '../layouts/Base.astro';
import { SITE, navFor } from '../data/site';
import { blogIsLive } from '../lib/blog-live';
import { placeholdersVisible } from '../lib/content';
import { findPhoto } from '../lib/photo';

// The portrait is used when public/images/photo.jpg exists at build time. Until then a published page has no photo slot and the hero is text only;
// the dev server and the test build show a marked placeholder slot, so the author sees what is missing.
const photo = findPhoto();
const showPlaceholder = !photo && placeholdersVisible();
const textOnly = !photo && !showPlaceholder;

// The doors are the top-bar links without Home, so they carry the same hints (one source of truth). Blog is one of them only once a post is published.
const doors = navFor('home', await blogIsLive());

// Small links under the doors. Google Scholar appears only once its address is set in src/data/site.ts.
const elsewhere = [
  { label: 'LinkedIn', href: SITE.links.linkedin },
  { label: 'GitHub', href: SITE.links.github },
  ...(SITE.links.scholar ? [{ label: 'Google Scholar', href: SITE.links.scholar }] : []),
];
---

<Base title={SITE.name} page="home">
  <div class="landing">
    <div class:list={['hero', { 'text-only': textOnly }]}>
      {
        photo ? (
          <div class="photo">
            <img src={photo} alt={`Portrait of ${SITE.name}`} width="260" height="325" />
          </div>
        ) : (
          showPlaceholder && (
            <div class="photo" data-placeholder="photo">
              Your photo
            </div>
          )
        )
      }
      <div>
        <h1>{SITE.name}</h1>
        <p class="role">{SITE.role}</p>
        <p class="intro">
          I work between R&amp;D and the business on the strategy, roadmap and investment plan of AI products for
          gastrointestinal endoscopy, with seventeen years of technical and six years of product experience. In my
          research, I worked with clinicians across specialties and started each project from a problem they faced. In
          industry, I gained first-hand knowledge of how medical devices are funded, regulated and brought to market.
        </p>
        <p class="background">
          Before Olympus: Pentax Medical, the German Cancer Research Center, IRCAD in Strasbourg and Taiwan. PhD in
          Computer Science, Université Nice Sophia Antipolis.
        </p>
      </div>
    </div>

    <div class="doors" style={`--doors: ${doors.length}`}>
      {
        doors.map((door) => {
          const id = door.label.toLowerCase();
          return (
            <a class="door" href={door.href} aria-labelledby={`door-${id}-title`} aria-describedby={`door-${id}-hint`}>
              <span class="door-head">
                <span class="door-title" id={`door-${id}-title`}>
                  {door.label}
                </span>
              </span>
              <span class="hint" id={`door-${id}-hint`}>
                {door.hint}
              </span>
            </a>
          );
        })
      }
    </div>

    <div class="elsewhere">
      {elsewhere.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
  </div>
</Base>

<style>
  /* Centres the content in the space between the top bar and the footer on a tall screen. The bar (68 px), the footer (87 px) and the main area's padding (104 px) add up to 259 px; 290 px leaves slack so a tall screen does not get a scrollbar. */
  .landing {
    min-height: calc(100vh - 290px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 32px 0 48px;
  }

  /* Portrait on the left (260 px), text on the right. minmax(0, 1fr) lets the text column shrink instead of forcing a sideways scroll. */
  .hero {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 56px;
    align-items: center;
    margin-bottom: 64px;
  }

  /* No photo yet: the text is the whole hero, in one column, so no empty space is kept for a portrait. */
  .hero.text-only {
    grid-template-columns: minmax(0, 1fr);
  }

  /* The photo slot is 4:5. The placeholder is a dashed frame with the words "Your photo". */
  .photo {
    width: 260px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 14px;
  }

  .photo[data-placeholder] {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--frame-2);
    border: 1px dashed var(--muted);
    color: var(--muted);
    font-size: 14px;
  }

  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h1 {
    margin: 0;
    font-size: 54px;
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .role {
    margin: 10px 0 18px;
    font-size: 21px;
    color: var(--muted);
  }

  .intro {
    margin: 0 0 14px;
    max-width: 820px;
    font-size: 19px;
  }

  .background {
    margin: 0;
    max-width: 820px;
    font-size: 16px;
    color: var(--muted);
  }

  /* One equal column for each door: three while the Blog door is there, two until the first post is published. The row's --doors says how many. */
  .doors {
    display: grid;
    grid-template-columns: repeat(var(--doors, 3), minmax(0, 1fr));
    gap: 20px;
  }

  .door {
    display: block;
    padding: 22px 26px;
    background: var(--frame);
    border: 1px solid var(--rule);
    border-radius: 14px;
    color: var(--ink-strong);
  }

  .door:hover {
    text-decoration: none;
    border-color: var(--accent);
  }

  /* The arrow is drawn on the wrapper, not on the title the link is named from, so it is not read out as part of the name. */
  .door-head {
    display: block;
    font-size: 26px;
    font-weight: 500;
  }

  .door-head::after {
    content: ' \2192';
    color: var(--muted);
  }

  .door:hover .door-head {
    color: var(--accent);
  }

  /* The hint is hidden until the door is hovered or has keyboard focus. Its space stays reserved so the doors do not jump. */
  .door .hint {
    display: block;
    min-height: 3em;
    margin-top: 6px;
    font-size: 15.5px;
    line-height: 1.45;
    color: var(--muted);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .door .hint {
      transition: opacity 0.15s ease;
    }
  }

  .door:hover .hint,
  .door:focus-visible .hint {
    opacity: 1;
  }

  /* A touch screen has no hover, so the hints stay shown there. This applies to these doors only; the top-bar hints stay hover and focus only. */
  @media (hover: none) {
    .door .hint {
      opacity: 1;
    }
  }

  .elsewhere {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-top: 36px;
    font-size: 15px;
  }

  .elsewhere a {
    color: var(--muted);
  }

  /* One column below 860 px: the photo shrinks to 160 px and sits above the text, and the doors stack. */
  @media (max-width: 860px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      margin-bottom: 40px;
    }

    .photo {
      width: 160px;
    }

    .doors {
      grid-template-columns: minmax(0, 1fr);
    }

    h1 {
      font-size: 40px;
    }
  }
</style>
