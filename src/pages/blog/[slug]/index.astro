---
// One post page: the title, the date, the tags as links and the post text, in a column of about 860 px.
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Frame from '../../../components/Frame.astro';
import PageHead from '../../../components/PageHead.astro';
import TagPills from '../../../components/TagPills.astro';
import { SITE } from '../../../data/site';
import { isPublished } from '../../../lib/content';
import { formatDay } from '../../../lib/projects';

/**
 * Tell Astro which post pages to build: one per published file in src/content/posts, at /blog/<file name>/.
 * A draft post has no page in the production build, so its address does not exist there.
 * @returns one route per published post, carrying the post entry as a prop.
 */
export async function getStaticPaths() {
  const posts = await getCollection('posts', isPublished);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, summary, tags } = post.data;
---

<Base title={`${title} | ${SITE.name}`} page="blog" subpage description={summary} ogType="article">
  <div class="reading">
    <PageHead title={title}>
      <p class="meta"><time datetime={date.toISOString().slice(0, 10)}>{formatDay(date)}</time></p>
      <TagPills tags={tags} />
    </PageHead>
    <Frame span={12}>
      <div class="post-body">
        <Content />
      </div>
    </Frame>
  </div>
</Base>

<style>
  /* Running text is at most 860 px wide: that width plus the frame's side padding (2 x 32 px) and border (2 x 1 px). */
  .reading {
    max-width: calc(860px + 64px + 2px);
  }

  .meta {
    margin: 6px 0 10px;
    font-size: 16px;
    color: var(--muted);
  }

  /* The post text is Markdown output, which this page's scoped styles cannot reach, so its elements are styled through :global
     under .post-body. They are styled for reading, and nothing here is shared with the privacy page. */
  .post-body :global(h2) {
    margin: 32px 0 12px;
    font-size: 24px;
    line-height: 1.3;
  }

  .post-body :global(h3) {
    margin: 26px 0 8px;
    font-size: 19px;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 14px;
    padding-left: 24px;
  }

  .post-body :global(li) {
    margin-bottom: 6px;
  }

  /* A link inside running text is underlined, so colour is not the only sign that it is a link. */
  .post-body :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-body :global(blockquote) {
    margin: 0 0 14px;
    padding: 2px 0 2px 18px;
    border-left: 3px solid var(--rule);
    color: var(--muted);
  }

  /* Code that is wider than the column scrolls inside its own box, never the whole page. */
  .post-body :global(pre) {
    margin: 0 0 14px;
    padding: 14px 16px;
    overflow-x: auto;
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: 10px;
    font-size: 15px;
    line-height: 1.5;
  }

  .post-body :global(code) {
    font-size: 0.9em;
  }

  .post-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 10px;
  }

  .post-body :global(table) {
    display: block;
    max-width: 100%;
    margin: 0 0 14px;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 16px;
  }

  /* A cell breaks only between words. The page-wide rule that breaks inside a long word would shrink every column to one letter
     instead of letting a wide table scroll in its box. */
  .post-body :global(th),
  .post-body :global(td) {
    padding: 6px 12px;
    border: 1px solid var(--rule);
    text-align: left;
    overflow-wrap: normal;
  }

  .post-body :global(hr) {
    margin: 28px 0;
    border: 0;
    border-top: 1px solid var(--rule);
  }

  @media (max-width: 860px) {
    .post-body :global(h2) {
      font-size: 22px;
    }
  }
</style>
